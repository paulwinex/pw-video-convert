set shell := ["bash", "-uc"]

default: dev

# зависимости бэкенда и фронта
install: install-backend install-front

[working-directory: 'backend']
install-backend:
	uv sync

[working-directory: 'frontend']
install-front:
	yarn install

# запуск бэкенда с автоперезагрузкой
[working-directory: 'backend']
dev:
	uv run uvicorn app.main:app --reload --host 127.0.0.1 --port 8000

# запуск без reload
[working-directory: 'backend']
run:
	uv run uvicorn app.main:app --host 127.0.0.1 --port 8000

# фронтенд dev-сервер
[working-directory: 'frontend']
front:
	yarn dev

# сборка фронтенда в frontend/dist (отдаётся бэкендом на /)
[working-directory: 'frontend']
build:
	yarn build
