set shell := ["bash", "-uc"]

default: dev

# зависимости бэкенда и фронта
install: install-backend install-front

[working-directory: 'backend']
install-backend:
	uv sync

[working-directory: 'frontend']
install-front:
	yarn install

# запуск бэкенда с автоперезагрузкой
[working-directory: 'backend']
dev:
	uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000 --timeout-graceful-shutdown 3

# запуск без reload
[working-directory: 'backend']
run:
	uv run uvicorn app.main:app --host 0.0.0.0 --port 8000 --timeout-graceful-shutdown 3

# фронтенд dev-сервер
[working-directory: 'frontend']
front:
	yarn dev

# сборка фронтенда в frontend/dist (отдаётся бэкендом на /)
[working-directory: 'frontend']
build:
	yarn build

[group('frontend')]
[script]
seticon SOURCE:
    set +e
    SOURCE_PATH="{{SOURCE}}"
    case "$SOURCE_PATH" in
        /*) ;;
        *) SOURCE_PATH="$PWD/$SOURCE_PATH" ;;
    esac

    if [ ! -f "$SOURCE_PATH" ]; then
        echo "File not found: $SOURCE_PATH" >&2
        exit 1
    fi

    cd frontend || exit 1
    npx --yes @quasar/icongenie generate -m spa -i "$SOURCE_PATH" --quality 8
    exit $?
#